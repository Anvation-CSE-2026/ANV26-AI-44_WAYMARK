# Frontend environment (copy to .env.local)

# Dev: leave empty. Vite proxies /api/* to VITE_PROXY_TARGET.
# Production build: set to the public URL of the FastAPI backend, e.g.
#   VITE_API_BASE=https://waymark-api.example.com
VITE_API_BASE=

# Where the dev/preview server proxies /api (default shown)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Base map. Default is OpenStreetMap: no key needed.
# To use MapTiler (Street + Satellite views): sign up at https://cloud.maptiler.com, copy your key, then
#   VITE_TILE_PROVIDER=maptiler
#   VITE_TILE_KEY=your_maptiler_key
# Optional MapTiler map ids (defaults shown; 'satellite' = imagery only, no labels):
#   VITE_TILE_STREET_STYLE=streets-v4
#   VITE_TILE_SATELLITE_STYLE=hybrid
# Restart `npm run dev` after editing this file. Never commit your real key.
VITE_TILE_PROVIDER=osm
VITE_TILE_KEY=

# Operations screens without a backend: set to 1 to serve reports, the assistant, the action plan and photo evidence
# from in-memory fixtures (src/lib/mocks). The map still needs the API. Restart `npm run dev` after changing.
VITE_USE_MOCKS=
