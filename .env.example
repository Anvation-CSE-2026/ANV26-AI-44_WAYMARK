# Leave DATABASE_URL unset for local SQLite development.
# For production, use the Supabase session pooler URL when Render requires IPv4.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=waymark-files
WAYMARK_DB=waymark.db
WAYMARK_DATA_DIR=data
WAYMARK_JWT_SECRET=replace-with-a-long-random-secret
